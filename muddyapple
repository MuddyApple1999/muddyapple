<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Klasik Flappy Kuş</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #1e272e;
            font-family: 'Courier New', Courier, monospace;
            user-select: none;
        }
        canvas {
            border: 4px solid #000;
            border-radius: 10px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.5);
            background-color: #70c5ce;
        }
    </style>
</head>
<body>

<canvas id="oyun" width="400" height="600"></canvas>

<script>
    const canvas = document.getElementById("oyun");
    const ctx = canvas.getContext("2d");

    // Ses Efektleri (Harici dosya gerektirmeyen Web Audio API)
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function sesCal(tip) {
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        if (tip === 'zipla') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(300, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(600, audioCtx.currentTime + 0.1);
            gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.1);
        } else if (tip === 'puan') {
            osc.type = 'square';
            osc.frequency.setValueAtTime(900, audioCtx.currentTime);
            osc.frequency.setValueAtTime(1200, audioCtx.currentTime + 0.08);
            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.2);
        } else if (tip === 'carpma') {
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(150, audioCtx.currentTime);
            osc.frequency.linearRampToValueAtTime(50, audioCtx.currentTime + 0.3);
            gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.3);
        }
    }

    // Oyun Durumları
    let durum = "BASLANGIC"; // BASLANGIC, OYNANIYOR, BITTI
    let kare = 0;
    let skor = 0;
    let enYuksekSkor = localStorage.getItem("flappy_rekor") || 0;

    // Zemin Bilgileri
    const zemin = {
        yukseklik: 100,
        x: 0,
        hiz: 2.5,
        ciz: function() {
            // Toprak kısmı
            ctx.fillStyle = "#ded895";
            ctx.fillRect(0, canvas.height - this.yukseklik, canvas.width, this.yukseklik);
            
            // Üstteki çimen şeridi
            ctx.fillStyle = "#73bf2e";
            ctx.fillRect(0, canvas.height - this.yukseklik, canvas.width, 18);
            
            // Çimen hareket çizgileri
            ctx.fillStyle = "#9ce659";
            for (let i = this.x; i < canvas.width; i += 24) {
                ctx.beginPath();
                ctx.moveTo(i, canvas.height - this.yukseklik + 2);
                ctx.lineTo(i + 12, canvas.height - this.yukseklik + 2);
                ctx.lineTo(i + 4, canvas.height - this.yukseklik + 16);
                ctx.lineTo(i - 8, canvas.height - this.yukseklik + 16);
                ctx.closePath();
                ctx.fill();
            }

            // Çerçeve çizgileri
            ctx.strokeStyle = "#543847";
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(0, canvas.height - this.yukseklik);
            ctx.lineTo(canvas.width, canvas.height - this.yukseklik);
            ctx.moveTo(0, canvas.height - this.yukseklik + 18);
            ctx.lineTo(canvas.width, canvas.height - this.yukseklik + 18);
            ctx.stroke();
        },
        guncelle: function() {
            if (durum === "OYNANIYOR" || durum === "BASLANGIC") {
                this.x = (this.x - this.hiz) % 24;
            }
        }
    };

    // Arka Plan (Bulutlar ve Şehir)
    function arkaPlanCiz() {
        // Gökyüzü
        ctx.fillStyle = "#70c5ce";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // Bulutlar
        ctx.fillStyle = "#e8f8f5";
        ctx.beginPath();
        ctx.arc(80, 380, 40, 0, Math.PI * 2);
        ctx.arc(130, 370, 50, 0, Math.PI * 2);
        ctx.arc(180, 385, 35, 0, Math.PI * 2);
        ctx.arc(290, 390, 45, 0, Math.PI * 2);
        ctx.arc(340, 375, 55, 0, Math.PI * 2);
        ctx.fill();

        // Uzak Şehir Silüeti
        ctx.fillStyle = "#a3e4d7";
        const binalar = [
            {x: 10, w: 40, h: 110}, {x: 55, w: 35, h: 140}, {x: 95, w: 50, h: 90},
            {x: 160, w: 45, h: 130}, {x: 215, w: 40, h: 100}, {x: 270, w: 55, h: 150},
            {x: 335, w: 45, h: 115}
        ];
        binalar.forEach(b => {
            ctx.fillRect(b.x, canvas.height - zemin.yukseklik - b.h, b.w, b.h);
        });

        // Çalılıklar
        ctx.fillStyle = "#82e0aa";
        for (let i = 0; i <= canvas.width; i += 40) {
            ctx.beginPath();
            ctx.arc(i, canvas.height - zemin.yukseklik, 28, 0, Math.PI, true);
            ctx.fill();
        }
    }

    // Kuş Nesnesi
    const kus = {
        x: 80,
        y: 250,
        yaricap: 16,
        hiz: 0,
        yerCekimi: 0.42,
        ziplama: -7.5,
        aci: 0,
        kanatY: 0,

        ciz: function() {
            ctx.save();
            ctx.translate(this.x, this.y);
            ctx.rotate(this.aci);

            // Gövde (Sarı Oval)
            ctx.fillStyle = "#f4d03f";
            ctx.beginPath();
            ctx.ellipse(0, 0, 18, 14, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.lineWidth = 2.5;
            ctx.strokeStyle = "#543847";
            ctx.stroke();

            // Göz (Beyaz + Siyah Bebek)
            ctx.fillStyle = "#fff";
            ctx.beginPath();
            ctx.arc(7, -4, 5.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = "#000";
            ctx.beginPath();
            ctx.arc(9, -4, 2, 0, Math.PI * 2);
            ctx.fill();

            // Gaga (Turuncu Dudaklar)
            ctx.fillStyle = "#e67e22";
            ctx.beginPath();
            ctx.roundRect(10, 0, 12, 5, 3);
            ctx.roundRect(10, 5, 10, 4, 3);
            ctx.fill();
            ctx.stroke();

            // Kanat (Çırpma animasyonlu)
            ctx.fillStyle = "#fef9e7";
            ctx.beginPath();
            ctx.ellipse(-4, 2 + this.kanatY, 8, 5, -0.2, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            ctx.restore();
        },

        guncelle: function() {
            if (durum === "BASLANGIC") {
                // Başlangıçta havada süzülme
                this.y = 240 + Math.sin(kare * 0.1) * 8;
                this.kanatY = Math.sin(kare * 0.3) * 3;
                this.aci = 0;
            } else if (durum === "OYNANIYOR") {
                this.hiz += this.yerCekimi;
                this.y += this.hiz;

                // Kanat çırpma
                this.kanatY = Math.sin(kare * 0.4) * 3;

                // Hıza göre burun açısı
                if (this.hiz < 0) {
                    this.aci = -0.45; // Yukarı bak
                } else {
                    this.aci = Math.min(Math.PI / 2, this.aci + 0.06); // Aşağı dalış
                }

                // Tavana çarpma sınırı
                if (this.y - this.yaricap < 0) {
                    this.y = this.yaricap;
                    this.hiz = 0;
                }

                // Yere çarpma
                if (this.y + this.yaricap >= canvas.height - zemin.yukseklik) {
                    this.y = canvas.height - zemin.yukseklik - this.yaricap;
                    oyunuBitir();
                }
            }
        },

        zipla: function() {
            this.hiz = this.ziplama;
            sesCal('zipla');
        }
    };

    // Borular
    const borular = {
        liste: [],
        genislik: 62,
        bosluk: 135,

        ciz: function() {
            this.liste.forEach(b => {
                // Boru Gövdesi Rengi (Işık-gölge efektli yeşil)
                let gradyan = ctx.createLinearGradient(b.x, 0, b.x + this.genislik, 0);
                gradyan.addColorStop(0, "#558b2f");
                gradyan.addColorStop(0.3, "#9ccc65");
                gradyan.addColorStop(0.7, "#7cb342");
                gradyan.addColorStop(1, "#33691e");

                ctx.fillStyle = gradyan;
                ctx.strokeStyle = "#2e1a12";
                ctx.lineWidth = 2.5;

                // ÜST BORU
                ctx.fillRect(b.x, 0, this.genislik, b.ust);
                ctx.strokeRect(b.x, -2, this.genislik, b.ust + 2);
                // Üst Boru Ağzı (Başlık)
                ctx.fillRect(b.x - 4, b.ust - 26, this.genislik + 8, 26);
                ctx.strokeRect(b.x - 4, b.ust - 26, this.genislik + 8, 26);

                // ALT BORU
                let altYukseklik = canvas.height - zemin.yukseklik - b.alt;
                ctx.fillRect(b.x, b.alt, this.genislik, altYukseklik);
                ctx.strokeRect(b.x, b.alt, this.genislik, altYukseklik);
                // Alt Boru Ağzı (Başlık)
                ctx.fillRect(b.x - 4, b.alt, this.genislik + 8, 26);
                ctx.strokeRect(b.x - 4, b.alt, this.genislik + 8, 26);
            });
        },

        guncelle: function() {
            if (durum !== "OYNANIYOR") return;

            // Her 105 karede bir yeni boru üret
            if (kare % 105 === 0) {
                let minUst = 60;
                let maxUst = canvas.height - zemin.yukseklik - this.bosluk - 60;
                let ustY = Math.floor(Math.random() * (maxUst - minUst + 1)) + minUst;

                this.liste.push({
                    x: canvas.width,
                    ust: ustY,
                    alt: ustY + this.bosluk,
                    gecildi: false
                });
            }

            this.liste.forEach(b => {
                b.x -= zemin.hiz;

                // Çarpışma Kontrolü
                if (
                    kus.x + kus.yaricap - 3 > b.x &&
                    kus.x - kus.yaricap + 3 < b.x + this.genislik &&
                    (kus.y - kus.yaricap + 3 < b.ust || kus.y + kus.yaricap - 3 > b.alt)
                ) {
                    oyunuBitir();
                }

                // Skor Kontrolü
                if (b.x + this.genislik < kus.x && !b.gecildi) {
                    skor++;
                    b.gecildi = true;
                    sesCal('puan');
                    if (skor > enYuksekSkor) {
                        enYuksekSkor = skor;
                        localStorage.setItem("flappy_rekor", enYuksekSkor);
                    }
                }
            });

            // Ekrandan çıkanları temizle
            this.liste = this.liste.filter(b => b.x + this.genislik + 10 > 0);
        }
    };

    // Arayüz ve Skor Tabelaları
    function arayuzCiz() {
        ctx.textAlign = "center";

        if (durum === "BASLANGIC") {
            ctx.fillStyle = "#fff";
            ctx.strokeStyle = "#000";
            ctx.lineWidth = 4;
            ctx.font = "bold 36px Arial";
            ctx.strokeText("HAZIRLAN!", canvas.width / 2, 140);
            ctx.fillText("HAZIRLAN!", canvas.width / 2, 140);

            ctx.font = "bold 18px Arial";
            ctx.lineWidth = 3;
            ctx.strokeText("Zıplamak için Tıkla veya Boşluk'a Bas", canvas.width / 2, 330);
            ctx.fillText("Zıplamak için Tıkla veya Boşluk'a Bas", canvas.width / 2, 330);
        }

        if (durum === "OYNANIYOR") {
            ctx.fillStyle = "#fff";
            ctx.strokeStyle = "#000";
            ctx.lineWidth = 5;
            ctx.font = "bold 48px Arial";
            ctx.strokeText(skor, canvas.width / 2, 70);
            ctx.fillText(skor, canvas.width / 2, 70);
        }

        if (durum === "BITTI") {
            // Game Over Yazısı
            ctx.fillStyle = "#e67e22";
            ctx.strokeStyle = "#fff";
            ctx.lineWidth = 5;
            ctx.font = "bold 40px Arial";
            ctx.strokeText("OYUN BİTTİ", canvas.width / 2, 150);
            ctx.fillText("OYUN BİTTİ", canvas.width / 2, 150);

            // Skor Kartı Kutusu
            ctx.fillStyle = "#ded895";
            ctx.strokeStyle = "#543847";
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.roundRect(75, 180, 250, 140, 12);
            ctx.fill();
            ctx.stroke();

            // Skorlar
            ctx.fillStyle = "#543847";
            ctx.font = "bold 20px Arial";
            ctx.fillText("SKOR", canvas.width / 2, 215);
            ctx.font = "bold 30px Arial";
            ctx.fillText(skor, canvas.width / 2, 248);

            ctx.font = "bold 16px Arial";
            ctx.fillText("EN İYİ: " + enYuksekSkor, canvas.width / 2, 295);

            // Tekrar Oyna Butonu
            ctx.fillStyle = "#e67e22";
            ctx.beginPath();
            ctx.roundRect(120, 345, 160, 45, 8);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = "#fff";
            ctx.font = "bold 20px Arial";
            ctx.fillText("TEKRAR OYNA", canvas.width / 2, 374);
        }
    }

    function oyunuBitir() {
        if (durum !== "BITTI") {
            durum = "BITTI";
            sesCal('carpma');
        }
    }

    function oyunuSifirla() {
        kus.y = 250;
        kus.hiz = 0;
        kus.aci = 0;
        borular.liste = [];
        skor = 0;
        kare = 0;
        durum = "BASLANGIC";
    }

    // Kontroller
    function girdiAl() {
        if (durum === "BASLANGIC") {
            durum = "OYNANIYOR";
            kus.zipla();
        } else if (durum === "OYNANIYOR") {
            kus.zipla();
        } else if (durum === "BITTI") {
            oyunuSifirla();
        }
    }

    window.addEventListener("keydown", (e) => {
        if (e.code === "Space" || e.code === "ArrowUp") {
            e.preventDefault();
            girdiAl();
        }
    });
    canvas.addEventListener("mousedown", girdiAl);
    canvas.addEventListener("touchstart", (e) => {
        e.preventDefault();
        girdiAl();
    });

    // Ana Oyun Döngüsü
    function dongu() {
        arkaPlanCiz();
        borular.guncelle();
        borular.ciz();
        zemin.guncelle();
        zemin.ciz();
        kus.guncelle();
        kus.ciz();
        arayuzCiz();

        kare++;
        requestAnimationFrame(dongu);
    }

    dongu();
</script>
</body>
</html>
